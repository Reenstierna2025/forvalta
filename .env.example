DOMAIN=forvalta.example.org
PUBLIC_ORIGIN=https://forvalta.example.org
ALLOWED_HOSTS=forvalta.example.org
CSRF_TRUSTED_ORIGINS=https://forvalta.example.org
SECRET_KEY=
MFA_ENCRYPTION_KEY=
POSTGRES_DB=forvalta
DB_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Private EU/EES object storage, SSE-S3 compatible, versioning enabled.
S3_ENDPOINT_URL=https://s3.example.org
S3_BUCKET=forvalta-private
S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=forvalta@example.org
# Separate backup account and bucket, never reuse application credentials.
PGBACKREST_REPO1_S3_BUCKET=forvalta-backup
PGBACKREST_REPO1_S3_ENDPOINT=s3.example.org
PGBACKREST_REPO1_S3_REGION=eu-north-1
PGBACKREST_REPO1_S3_URI_STYLE=path
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
# Isolated document/configuration backup. Not passed to API or worker.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=https://s3.example.org
BACKUP_S3_BUCKET=forvalta-documents-backup
BACKUP_S3_REGION=eu-north-1
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# Optional explicit HTTPS origins for self-hosted AI on private networks.
AI_PRIVATE_ORIGINS=
